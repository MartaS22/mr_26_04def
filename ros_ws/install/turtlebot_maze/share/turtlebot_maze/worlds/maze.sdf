       <!-- Chiave 1 (ArUco ID 1) - Marker solo su 2 facce -->
    <model name="key_1">
      <static>true</static>
      <pose>-2.0 -4.0 0.15 0 0 1.57</pose>
      <link name="link">
        
        <!-- Collisione fisica del cubo per Nav2 -->
        <collision name="collision">
          <geometry><box><size>0.05 0.3 0.3</size></box></geometry>
        </collision>
 
        <!-- 1. IL CUBO BASE (Completamente Nero) -->
        <visual name="cubo_base">
          <geometry><box><size>0.05 0.3 0.3</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1.0</ambient>
            <diffuse>0.05 0.05 0.05 1.0</diffuse>
          </material>
        </visual>
 
        <!-- 2. FACCIA FRONTALE (Con Marker Emissivo) -->
        <visual name="marker_frontale1">
          <!-- Posizionata esattamente a filo del lato anteriore (0.151m dal centro) -->
          <pose>0.026 0 0 0 0 0</pose>
          <!-- Spessore invisibile di 1 millimetro, larga e alta 30 cm -->
          <geometry><box><size>0.001 0.3 0.3</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <emissive>1.0 1.0 1.0 1.0</emissive>
            <pbr>
              <metal>
                <albedo_map>package://turtlebot_maze/models/aruco_textures/marker_1.png</albedo_map>
                <emissive_map>package://turtlebot_maze/models/aruco_textures/marker_1.png</emissive_map>
              </metal>
            </pbr>
          </material>
        </visual>
 
        <!-- 3. FACCIA POSTERIORE (Con Marker Emissivo) -->
        <visual name="marker_posteriore1">
          <!-- Posizionata esattamente a filo del lato posteriore (-0.151m dal centro) -->
          <pose>-0.026 0 0 0 0 0</pose>
          <geometry><box><size>0.001 0.3 0.3</size></box></geometry>
          <material>
            <ambient>1.0 1.0 1.0 1.0</ambient>
            <diffuse>1.0 1.0 1.0 1.0</diffuse>
            <emissive>1.0 1.0 1.0 1.0</emissive>
            <pbr>
              <metal>
                <albedo_map>package://turtlebot_maze/models/aruco_textures/marker_1.png</albedo_map>
                <emissive_map>package://turtlebot_maze/models/aruco_textures/marker_1.png</emissive_map>
              </metal>
            </pbr>
          </material>
        </visual>
      </link>
    </model>


       <!-- Chiave 2 (ArUco ID 2) - Marker solo su 2 facce -->
    <model name="key_2">
      <static>true</static>
      <pose>0.8 2.0 0.15 0 0 0</pose>
      <link name="link">
        
        <!-- Collisione fisica del cubo per Nav2 -->
